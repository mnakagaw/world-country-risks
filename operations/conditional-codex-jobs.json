{
  "version": "countryrisks-local-v2",
  "jobs": [
    {
      "id": "countryrisks-daily",
      "hours": [
        3
      ],
      "minutes": [
        20
      ],
      "argv": [
        "{python}",
        "-X",
        "utf8",
        "-B",
        "scripts/periodic_adapter.py",
        "--result",
        "{result}"
      ],
      "ownership": "Existing shared Windows tick; legacy CountryRisks daily Actions disabled before cutover",
      "raw_collection_added": false,
      "google_rss_collection": false,
      "restore_enabled": false,
      "retry_statuses": [
        "waiting_execbrief_daily",
        "retry_sync_stage",
        "busy"
      ],
      "retry_seconds": 900,
      "dependency": "ExecBrief same-day verified publication+acceptance and03:00 seal",
      "sync_effective_date": "2026-10-15",
      "retry_deadline": "23:55 JST same edition date; max84 checks"
    },
    {
      "id": "countryrisks-weekly",
      "weekdays": [
        0
      ],
      "hours": [
        11
      ],
      "minutes": [
        0
      ],
      "argv": [
        "{python}",
        "-X",
        "utf8",
        "-B",
        "scripts/periodic_adapter.py",
        "--weekly",
        "--result",
        "{result}"
      ],
      "ownership": "Existing shared Windows tick; legacy Monday02:00 UTC weekly Actions disabled before cutover",
      "raw_collection_added": false,
      "google_rss_collection": false,
      "restore_enabled": false
    }
  ]
}
